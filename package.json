{
  "name": "@yurushao/dsh-model-router",
  "version": "0.4.0",
  "description": "DSH Model Router: automatic model selection for DeepSeek Harness, powered by Jev",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "examples",
    "scripts/smoke-jev.mjs",
    "scripts/eval-jev.mjs",
    "scripts/desktop-routing-state.json",
    "LICENSE",
    "NOTICE",
    "compatibility",
    "patches",
    "scripts/prepare-harness.mjs",
    "scripts/verify-install.mjs",
    "scripts/installed-smoke.mjs",
    "scripts/verify-host.mjs",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "bun run build",
    "check": "bun run typecheck && bun run test && bun run build",
    "test:install": "node scripts/verify-install.mjs",
    "harness:prepare": "node scripts/prepare-harness.mjs",
    "test:host": "node scripts/verify-host.mjs"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "packageManager": "bun@1.3.3",
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.3",
    "@deepseek-ai/dsh-agent": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-llm": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-session": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-session-projection": "0.1.7-alpha.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.3",
    "@deepseek-ai/dsh-agent": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-agent-loop": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-llm": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-session": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-session-projection": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-tools": "0.1.7-alpha.1",
    "@types/node": "24",
    "typescript": "^5.9.3",
    "vitest": "3.2.4"
  },
  "license": "MIT",
  "author": "Yuru Shao",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yurushao/dsh-model-router.git"
  },
  "homepage": "https://github.com/yurushao/dsh-model-router#readme",
  "bugs": {
    "url": "https://github.com/yurushao/dsh-model-router/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "deepseek-harness",
    "model-routing",
    "jev",
    "openrouter"
  ],
  "patchedDependencies": {
    "@deepseek-ai/dsh-session@0.1.7-alpha.1": "patches/dsh-session-0.1.7-alpha.1.patch"
  }
}
